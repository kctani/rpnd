#!/bin/sh /etc/rc.common

USE_PROCD=1
#PROCD_DEBUG=
START=54
STOP=54

start_service() {
  procd_open_instance
  procd_set_param command /usr/bin/pigpiod
  procd_set_param pidfile /var/run/pigpio.pid
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

reload_service() {
  stop
  start
}

